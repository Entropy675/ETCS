DatabaseProvider
LocalDatabase
spawn
LocalDatabase.Connect test2.db
LocalDatabase.ExecuteRaw PRAGMA journal_mode=WAL;
LocalDatabase.ExecuteRaw PRAGMA synchronous=NORMAL;
LocalDatabase.InitializeSchema CREATE TABLE IF NOT EXISTS ace_test(id INTEGER PRIMARY KEY, val TEXT);
LocalDatabase.ExecuteTransaction DELETE FROM ace_test;INSERT INTO ace_test (val) VALUES ('Luke'), ('Sibte'), ('Test123'), ('Test3');
LocalDatabase.ExecuteRaw PRAGMA wal_checkpoint(FULL);
LocalDatabase.QueryProduce SELECT * FROM ace_test
LocalDatabase.RowConsume
