#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

spawn NetworkProvider::HttpServer web
web.SetPort(8443)
web.EnableTLS(/tmp/etcs-cert.pem /tmp/etcs-key.pem)

# Cross-origin isolation, site-wide -- SharedArrayBuffer, and therefore threads,
# for the -pthread wasm build at /paint. See run_website.etcs for why this is
# safe for the pages that came first and what it does change.
web.AddHeader(Cross-Origin-Opener-Policy same-origin)
web.AddHeader(Cross-Origin-Embedder-Policy require-corp)

web.spawn(NetworkProvider::StaticHtmlPage landing)
landing.SetHtmlFromFile(ACE_ROOT/scripts/www/index.html)

web.spawn(NetworkProvider::FileHtmlPage tree)
# THE LINK HUB, for a shared canvas and for a game of chess. A page hosts a
# Room in its own runtime through this hub (PaintShare, paint_host.etcs;
# ChessShare, chess_host.etcs), and the people it invites link to it here at
# /link/<session>: the hub splices bytes between them and holds nothing of
# the session. The chess hall and the ranked tables are Rooms of this
# runtime's own on the same hub (/link/hall, /link/table1).
web.spawn(NetworkProvider::LinkHub links)
tree.LoadFromDisk(ACE_ROOT/scripts/www)
run site_pages.etcs tree=tree
tree.SetDefaultExtension(.html)
tree.ListPaths()

# /paint -- the same second site, mounted the same way. See run_website.etcs for
# the whole argument; this file is the TLS spelling of it and nothing about the
# mounts differs.
#
# SetDefaultExtension above is THIS node's, not the subtree's: the paint page
# fetches exact names (modules.json, etcs.js, *.wasm, shell), so the prefix needs
# no extension guessing and inherits none.
tree.MountTree(paint ACE_ROOT/modules/PaintProvider/scripts/www)

# The one copy of the browser runtime, mounted whole: `ace wasm make` writes
# bin/wasm/ and nothing else does (Makefile, WASM_DIR, on why it is its own
# directory rather than bin/ and why a page never holds a copy).
tree.MountTree(wasm ACE_ROOT/bin/wasm)

# The paint page's own files, from its module's list of them -- the site only
# says where the page lives (FileHtmlPage::SetMountPrefix).
tree.SetMountPrefix(paint)
run PaintProvider/scripts/paint_mounts.etcs tree=tree
tree.SetMountPrefix()

# ── /chess ───────────────────────────────────────────────────────────────────
#
# /chess/ is a LANDING PAGE (scripts/www/chess/index.html): what there is to
# play, and the buttons that open it. The game is the wasm chess page, mounted
# two deep at /chess/play/ from its own module's list
# (ChessProvider/scripts/chess_mounts.etcs); it plays on the visitor's own
# runtime, and its hall -- who is hosting, which ranked table has a seat -- is
# a listing over the link, read from the two services this site runs below
# (chess_service.etcs, after Start). The server-played page it replaced is at
# /chess-classic (site_pages.etcs).
tree.SetMountPrefix(chess/play)
run ChessProvider/scripts/chess_mounts.etcs tree=tree
tree.SetMountPrefix()
tree.ListPaths()

spawn NetworkProvider::TarpitNode tarpit
tarpit.LoadDefaultTarpitPatterns()

web.AddHandler(@tarpit Request @tarpit Filter)
web.AddHandler(@web Serve)
web.Start()
web.IsStarted()

# THE HALL AND THE RANKED TABLES, on the hub above: the name server every
# casual game finds its partner through, and the two tables this runtime
# hosts and judges (ChessProvider/scripts/chess_service.etcs).
run ChessProvider/scripts/chess_service.etcs links=links
detach forum_lobby.etcs
