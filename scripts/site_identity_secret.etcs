#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── THE SECRET ACE IDENTITIES ARE DERIVED UNDER, ONCE ────────────────────────
#
#     etcs scripts/site_identity_secret.etcs
#
# Made in this machine's keystore as `ace-identity`, beside the registrar's key
# and never replaced. Every loader's ACE identity, and every account's rows,
# are derived from it: lost, every account is lost; replaced, the registrar
# refuses the accounts kept under the old one. Nothing of it is printed.

spawn DatabaseProvider::Keystore ace_secret
ace_secret.Connect(ace-identity)
spawn CryptProvider::Keypair ace_derive
ace_derive.Generate()
ace_derive.StoreTo(@ace_secret)
