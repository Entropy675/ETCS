#!/usr/bin/env etcs
#IMPORT ACE_ROOT/modules

# ── ACE'S HALF, AND WHAT THE SITE SERVES ─────────────────────────────────────
#
#     run site_pki.etcs web=web tree=tree
#
#   /pki    the registrar (CryptProvider::Registrar): a loader's key, proven,
#           gets its ACE identity's certificate for the epoch and the chain
#           above; accounts gather ACE identities
#   /dist   the binaries a download takes, and the marketplace's signed list
#           of them (`ace publish` writes ACE_ROOT/dist)
#
# The registrar's key is a Keypair kept in this machine's keystore as
# `registrar` (site_registrar_key.etcs makes it once). The certificates above
# it are ACE_ROOT/pki/{registrar,active,root}.cert, as the authority left them.
# Without them the registrar answers that it is not set up, and the rest of
# the site runs.
#
# ACE identities are derived under a second secret, `ace-identity`
# (site_identity_secret.etcs makes it once), and accounts are kept in
# ACE_ROOT/pki/accounts.db. The registrar takes registrations from loaders of
# this loader's identity, in its epoch and the one before (kept with the
# accounts, pki.Window to change): a release runs the site on its own loader
# first, and the last epoch's loaders register for the new one as they heal.

requires web [HttpServer]
requires tree [FileHtmlPage]

tree.MountTree(dist ACE_ROOT/dist)

spawn DatabaseProvider::Keystore pki_secret
pki_secret.Connect(registrar)
spawn CryptProvider::Keypair pki_key
pki_key.LoadFrom(@pki_secret)

spawn NetworkProvider::Embassy pki_embassy
spawn CryptProvider::Custody pki_files
spawn NetworkProvider::FileRelation pki_dir
pki_dir.Root(ACE_ROOT/pki)
pki_dir.Target(Directory)
pki_dir.Activate(@pki_files)
pki_embassy.Advertise(pki file @pki_dir)
pki_embassy.Open()
pki_files.SetEmbassy(@pki_embassy)
pki_files.SetRelation(pki)
spawn CryptProvider::Certificate pki_registrar_cert
pki_files.Recall(registrar @pki_registrar_cert)
spawn CryptProvider::Certificate pki_active_cert
pki_files.Recall(active @pki_active_cert)
spawn CryptProvider::Certificate pki_root_cert
pki_files.Recall(root @pki_root_cert)
pki_embassy.Close()

spawn DatabaseProvider::Keystore ace_secret
ace_secret.Connect(ace-identity)
spawn CryptProvider::Keypair ace_derive
ace_derive.LoadFrom(@ace_secret)
spawn DatabaseProvider::LocalDatabase ace_accounts
ace_accounts.Connect(ACE_ROOT/pki/accounts.db)

spawn CryptProvider::Registrar pki
pki.Use(@pki_key)
pki.Above(@pki_registrar_cert)
pki.Above(@pki_active_cert)
pki.Above(@pki_root_cert)
pki.Derive(@ace_derive)
pki.Accounts(@ace_accounts)
pki.Current()
web.AddRequestRoute(@pki Request @pki Filter)
