#!/usr/bin/env etcs
#IMPORT ACE_ROOT/scripts

spawn ForumWebsiteProvider::ForumNode node
node.Mount(forum)

spawn DatabaseProvider::LocalDatabase forumdb
forumdb.Connect(./forum.db)

node.Db(@forumdb)
node.InitDb()

forumdb.RowProduce(SELECT * FROM forum_thread) -> node.LoadRows()
forumdb.RowProduce(SELECT * FROM forum_post)   -> node.LoadRows()
forumdb.RowProduce(SELECT * FROM forum_body)   -> node.LoadRows()

node.Index()
node.Verify()

detach forum_web.etcs forum=node